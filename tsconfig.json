{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "packages/**/*.ts",
    "services/**/*.ts",
    "apps/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
