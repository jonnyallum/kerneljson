-- ADR-0026 Amendment A. Proposal, deliberately NOT in supabase/migrations/.
-- tests/support/local.ts migrate() applies every file in that folder to every database-backed
-- test, and the FM project auto-applies that folder. This script stays here so merging the
-- branch applies nothing. Apply it with the room runbook after Jonny's sign-off.
-- That sign-off is an ordinary approval (direction of 4 Nov 2026), not a named change window
-- and not a freeze exception.
-- The channel is narrative. task_ref is a bare pointer with no foreign key: a message cannot
-- change, and does not depend on, any task row.

create table if not exists agent_channel_counters (
  tenant_id uuid primary key references tenants(id),
  last_seq bigint not null default 0
);

create table if not exists agent_channel_messages (
  id uuid primary key,
  tenant_id uuid not null references tenants(id),
  seq bigint not null,
  thread_id uuid not null,
  kind text not null check (kind in ('NOTE','QUESTION','REPLY','HANDOFF','STATUS')),
  author_principal_id uuid not null references principals(id),
  author_kind text not null check (author_kind in ('HUMAN','SERVICE')),
  handle text not null check (handle ~ '^[a-z][a-z0-9-]{1,31}$'),
  body text not null check (char_length(body) between 1 and 4000),
  redacted boolean not null default false,
  in_reply_to uuid,
  task_ref uuid,
  idempotency_key text not null check (char_length(idempotency_key) between 8 and 128),
  content_hash text not null check (char_length(content_hash) = 64),
  created_at timestamptz not null default now(),
  unique (tenant_id, seq),
  unique (tenant_id, author_principal_id, idempotency_key)
);
create index if not exists agent_channel_messages_thread on agent_channel_messages (tenant_id, thread_id, seq);

create table if not exists agent_channel_acks (
  tenant_id uuid not null references tenants(id),
  principal_id uuid not null references principals(id),
  handle text not null,
  up_to_seq bigint not null check (up_to_seq > 0),
  acked_at timestamptz not null default now(),
  primary key (tenant_id, principal_id)
);

-- Room membership. The app role may read it. The operator inserts rows as the table owner.
create table if not exists agent_channel_members (
  tenant_id uuid not null references tenants(id),
  principal_id uuid not null references principals(id),
  handle text not null check (handle ~ '^[a-z][a-z0-9-]{1,31}$'),
  primary key (tenant_id, principal_id),
  unique (tenant_id, handle)
);

-- Per-recipient delivery. State moves only forward: pending, delivered, acked.
create table if not exists agent_channel_deliveries (
  tenant_id uuid not null references tenants(id),
  message_id uuid not null references agent_channel_messages(id),
  recipient_principal_id uuid not null references principals(id),
  handle text not null check (handle ~ '^[a-z][a-z0-9-]{1,31}$'),
  state text not null check (state in ('pending','delivered','acked')),
  updated_at timestamptz not null default now(),
  primary key (tenant_id, message_id, recipient_principal_id)
);
create index if not exists agent_channel_deliveries_recipient
  on agent_channel_deliveries (tenant_id, recipient_principal_id, state);

-- Messages are immutable: no update, no delete (retention is a later, separate job).
create or replace function agent_channel_messages_immutable() returns trigger language plpgsql as $$
begin
  raise exception 'agent_channel_messages is append-only';
end $$;
drop trigger if exists agent_channel_messages_no_change on agent_channel_messages;
create trigger agent_channel_messages_no_change
  before update or delete on agent_channel_messages
  for each row execute function agent_channel_messages_immutable();

create or replace function agent_channel_acks_forward() returns trigger language plpgsql as $$
begin
  if new.up_to_seq < old.up_to_seq then
    raise exception 'agent_channel_acks cannot move backwards';
  end if;
  if new.tenant_id <> old.tenant_id or new.principal_id <> old.principal_id then
    raise exception 'agent_channel_acks identity is immutable';
  end if;
  return new;
end $$;
drop trigger if exists agent_channel_acks_no_rewind on agent_channel_acks;
create trigger agent_channel_acks_no_rewind
  before update on agent_channel_acks
  for each row execute function agent_channel_acks_forward();

create or replace function agent_channel_deliveries_forward() returns trigger language plpgsql as $$
begin
  if old.state = 'acked' and new.state <> 'acked' then
    raise exception 'agent_channel_deliveries cannot move backwards from acked';
  end if;
  if old.state = 'delivered' and new.state = 'pending' then
    raise exception 'agent_channel_deliveries cannot move backwards from delivered';
  end if;
  if new.tenant_id <> old.tenant_id or new.message_id <> old.message_id
     or new.recipient_principal_id <> old.recipient_principal_id then
    raise exception 'agent_channel_deliveries identity is immutable';
  end if;
  return new;
end $$;
drop trigger if exists agent_channel_deliveries_no_rewind on agent_channel_deliveries;
create trigger agent_channel_deliveries_no_rewind
  before update on agent_channel_deliveries
  for each row execute function agent_channel_deliveries_forward();

-- Null or an unparseable setting matches no row. The store sets this inside each transaction.
create or replace function agent_channel_current_tenant() returns uuid language plpgsql stable as $$
declare raw text;
begin
  raw := current_setting('app.tenant_id', true);
  if raw is null or raw = '' then
    return null;
  end if;
  return raw::uuid;
exception when invalid_text_representation then
  return null;
end $$;

-- Answers only "is this principal an ACTIVE member of this tenant, with this kind?"
-- SECURITY DEFINER so the room login role is not granted the membership tables.
-- Apply this script as the table owner. The owner can read those tables; the room role cannot.
create or replace function agent_channel_member_active(p_tenant uuid, p_principal uuid, p_kind text)
returns boolean
language sql
stable
security definer
set search_path = pg_catalog, public
as $$
  select exists (
    select 1
    from public.tenant_memberships m
    join public.principals p on p.id = m.principal_id
    where m.tenant_id = p_tenant
      and m.principal_id = p_principal
      and p.kind = p_kind
      and m.status = 'ACTIVE'
  );
$$;

-- Row-level security. FORCE applies to the table owner. A superuser still bypasses it.
-- The room connects as agent_room_app (LOGIN, member of agent_channel), never as the
-- admission door's role and never as a superuser. agent_channel itself cannot log in.
-- No policy is created for anon or authenticated.
do $$ declare t text; begin
  foreach t in array array[
    'agent_channel_counters','agent_channel_messages','agent_channel_acks',
    'agent_channel_members','agent_channel_deliveries'
  ] loop
    execute format('alter table %I enable row level security', t);
    execute format('alter table %I force row level security', t);
    execute format('drop policy if exists %I on %I', t || '_tenant', t);
    execute format(
      'create policy %I on %I using (tenant_id = agent_channel_current_tenant()) with check (tenant_id = agent_channel_current_tenant())',
      t || '_tenant', t
    );
  end loop;
end $$;

revoke all on agent_channel_counters, agent_channel_messages, agent_channel_acks,
  agent_channel_members, agent_channel_deliveries from public, anon, authenticated;

do $$ begin
  if not exists (select 1 from pg_roles where rolname = 'agent_channel') then
    create role agent_channel nologin nobypassrls;
  end if;
  if not exists (select 1 from pg_roles where rolname = 'agent_room_app') then
    create role agent_room_app login inherit nobypassrls;
  end if;
end $$;
alter role agent_channel nologin nobypassrls;
-- LOGIN, but no password is set in this script. The operator sets it out of band.
alter role agent_room_app login inherit nobypassrls nosuperuser nocreatedb nocreaterole;
grant agent_channel to agent_room_app;
grant usage on schema public to agent_channel;
grant select, insert on agent_channel_messages to agent_channel;
grant select, insert, update on agent_channel_counters to agent_channel;
grant select, insert, update on agent_channel_acks to agent_channel;
grant select, insert, update on agent_channel_deliveries to agent_channel;
grant select on agent_channel_members to agent_channel;
revoke all on function agent_channel_member_active(uuid, uuid, text) from public;
grant execute on function agent_channel_member_active(uuid, uuid, text) to agent_channel;
